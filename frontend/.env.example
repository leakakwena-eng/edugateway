# Copy to .env.local to override.

# Where the dev server proxies /api requests (WildFly with the edugateway.war deployed).
VITE_BACKEND_URL=http://localhost:8080

# Base path the browser calls. Keep the default when the API is served from the same origin
# (dev proxy or a reverse proxy); set a full URL like https://api.example.com/edugateway/api/v1
# when the API lives on another origin (then also set EDUGATEWAY_CORS_ORIGINS on the backend).
# VITE_API_BASE_URL=/api/v1
